APP_NAME=Scrapbook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=scrapbook
DB_USERNAME=scrapbook
DB_PASSWORD=246810

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=scrapbook
AWS_URL=http://localhost:9000/scrapbook
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

SCRAPBOOK_MEDIA_DISK="${FILESYSTEM_DISK}"
SCRAPBOOK_MEDIA_MAX_UPLOAD_KB=5120
SCRAPBOOK_MEDIA_MAX_INPUT_WIDTH=6000
SCRAPBOOK_MEDIA_MAX_INPUT_HEIGHT=6000
SCRAPBOOK_MEDIA_PROCESSED_MAX_DIMENSION=2200
SCRAPBOOK_MEDIA_THUMBNAIL_MAX_DIMENSION=420
SCRAPBOOK_MEDIA_WEBP_QUALITY=82
SCRAPBOOK_MEDIA_THUMBNAIL_QUALITY=72
SCRAPBOOK_MEDIA_MAX_IMAGES_PER_GIFT=8
SCRAPBOOK_MEDIA_MAX_STORAGE_MB=50
SCRAPBOOK_PAYMENT_PROVIDER=manual_dev
SCRAPBOOK_DEV_PAYMENT_APPROVAL=true

ADMIN_NAME="Scrapbook Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
