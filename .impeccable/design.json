    "components": [
        {
            "name": "Primary Button",
            "kind": "button",
            "refersTo": "button-primary",
            "description": "Ação conclusiva única, coral e compacta.",
            "html": "<button class=\"ds-btn-primary\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><rect width=\"14\" height=\"16\" x=\"5\" y=\"4\" rx=\"2\"></rect><path d=\"M9 4.5h6v3H9zM9 12l2 2 4-4\"></path></svg>Revisar</button>",
            "css": ".ds-btn-primary{display:inline-flex;min-height:40px;align-items:center;justify-content:center;gap:8px;padding:0 12px;border:1px solid #ff9b88;border-radius:5px;background:var(--editor-coral,#ff765b);color:var(--editor-ink,#21162d);font:700 14px/1.2 \"Atkinson Hyperlegible\",ui-sans-serif,system-ui,sans-serif;box-shadow:inset 0 -2px 0 #c94e3a;transition:background-color 150ms ease,transform 150ms ease}.ds-btn-primary svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-btn-primary:hover{background:#ff8a72;transform:translateY(-1px)}.ds-btn-primary:focus-visible{outline:3px solid var(--editor-coral,#ff765b);outline-offset:3px}.ds-btn-primary:active{transform:translateY(1px)}"
        },
        {
            "name": "Utility Button",
            "kind": "button",
            "refersTo": "button-utility",
            "description": "Ação instrumental integrada ao chrome de berinjela.",
            "html": "<button class=\"ds-btn-utility\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg>Visualizar</button>",
            "css": ".ds-btn-utility{display:inline-flex;min-height:40px;align-items:center;justify-content:center;gap:8px;padding:0 12px;border:1px solid #4b3a58;border-radius:5px;background:var(--editor-ink-raised,#2a1d36);color:var(--editor-paper,#fbfaf6);font:700 14px/1.2 \"Atkinson Hyperlegible\",ui-sans-serif,system-ui,sans-serif;transition:background-color 150ms ease,border-color 150ms ease}.ds-btn-utility svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-btn-utility:hover{border-color:#6b557b;background:#382943}.ds-btn-utility:focus-visible{outline:3px solid var(--editor-coral,#ff765b);outline-offset:3px}.ds-btn-utility:active{background:#21162d}"
        },
        {
            "name": "Text Field",
            "kind": "input",
            "refersTo": "input",
            "description": "Campo branco preciso dentro da folha de ferramenta.",
            "html": "<label class=\"ds-field\"><span>Título da capa</span><input value=\"Nossa história\" aria-label=\"Título da capa\"></label>",
            "css": ".ds-field{display:grid;gap:8px;color:var(--editor-graphite,#342e38);font:700 14px/1.3 \"Atkinson Hyperlegible\",ui-sans-serif,system-ui,sans-serif}.ds-field input{min-height:44px;padding:10px 12px;border:1px solid var(--editor-rule,#c9c1cd);border-radius:6px;background:#fff;color:var(--editor-graphite,#342e38);font:400 14px/1.5 \"Atkinson Hyperlegible\",ui-sans-serif,system-ui,sans-serif;transition:border-color 150ms ease,box-shadow 150ms ease}.ds-field input:hover{border-color:var(--editor-pencil,#746d78)}.ds-field input:focus-visible{border-color:var(--editor-ink,#21162d);outline:none;box-shadow:0 0 0 3px rgba(33,22,45,.14)}.ds-field input:disabled{cursor:not-allowed;background:#efebf3;color:#746d78}"
        },
        {
            "name": "Binder Tabs",
            "kind": "nav",
            "refersTo": "binder-tab-active",
            "description": "Ambientes de ferramenta com canto recortado e estado coral.",
            "html": "<nav class=\"ds-tabs\" aria-label=\"Ferramentas\"><button class=\"ds-tab ds-tab-active\">Textos</button><button class=\"ds-tab\">Fotos</button><button class=\"ds-tab\">Adesivos</button></nav>",
            "css": ".ds-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:6px;background:var(--editor-workbench,#efebf3)}.ds-tab{min-height:48px;padding:6px;border:1px solid var(--editor-rule,#c9c1cd);clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,0 100%);background:var(--editor-paper,#fbfaf6);color:#5b5360;font:700 12px/1.2 \"Atkinson Hyperlegible\",ui-sans-serif,system-ui,sans-serif;transition:background-color 150ms ease,border-color 150ms ease,color 150ms ease}.ds-tab:hover{border-color:var(--editor-pencil,#746d78);background:#fff;color:var(--editor-ink,#21162d)}.ds-tab:focus-visible{outline:3px solid var(--editor-coral,#ff765b);outline-offset:2px}.ds-tab-active{border-color:var(--editor-ink,#21162d);background:var(--editor-ink,#21162d);color:var(--editor-paper,#fbfaf6);box-shadow:inset 0 -3px 0 var(--editor-coral,#ff765b)}"
        },
        {
            "name": "Page Ticket",
            "kind": "nav",
            "refersTo": "page-ticket-active",
            "description": "Entrada numerada da fita de páginas.",
            "html": "<button class=\"ds-page-ticket\" aria-current=\"page\"><span class=\"ds-page-number\"><small>PÁG.</small><strong>01</strong><i></i></span><span class=\"ds-page-copy\"><strong>Capa com foto</strong><small>Capa · salvo</small></span></button>",
            "css": ".ds-page-ticket{display:grid;width:190px;min-height:76px;grid-template-columns:44px minmax(0,1fr);align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--editor-paper,#fbfaf6);clip-path:polygon(0 0,calc(100% - 9px) 0,100% 9px,100% 100%,0 100%);background:var(--editor-paper,#fbfaf6);color:var(--editor-ink,#21162d);font-family:\"Atkinson Hyperlegible\",ui-sans-serif,system-ui,sans-serif;text-align:left;box-shadow:4px 4px 0 var(--editor-coral,#ff765b);transition:transform 150ms ease}.ds-page-ticket:hover{transform:translateY(-1px)}.ds-page-ticket:focus-visible{outline:3px solid var(--editor-coral,#ff765b);outline-offset:3px}.ds-page-number{display:grid;height:56px;place-content:space-between;padding:6px;border:1px solid var(--editor-rule,#c9c1cd);background:#fff;text-align:center}.ds-page-number small{font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--editor-pencil,#746d78)}.ds-page-number strong{font-size:18px}.ds-page-number i{width:20px;height:1px;margin:auto;background:var(--editor-coral,#ff765b)}.ds-page-copy{display:grid;gap:6px;min-width:0}.ds-page-copy strong{overflow:hidden;font-size:14px;text-overflow:ellipsis;white-space:nowrap}.ds-page-copy small{color:var(--editor-pencil,#746d78);font-size:11px}"
        },
        {
            "name": "Inset Tool Panel",
            "kind": "card",
            "refersTo": "tool-panel",
            "description": "Folha clara encaixada no fichário, reservada a controles.",
            "html": "<section class=\"ds-tool-panel\"><header><div><h3>Conteúdo da página</h3><p>2 textos editáveis · salvo</p></div><b aria-hidden=\"true\">T</b></header><div class=\"ds-tool-rule\"></div><p>Selecione um campo para editar a memória.</p></section>",
            "css": ".ds-tool-panel{padding:16px;border-radius:16px 4px 16px 16px;background:var(--editor-paper,#fbfaf6);color:var(--editor-graphite,#342e38);font:400 14px/1.5 \"Atkinson Hyperlegible\",ui-sans-serif,system-ui,sans-serif;box-shadow:0 14px 32px rgba(11,6,17,.24)}.ds-tool-panel header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.ds-tool-panel h3{margin:0;color:var(--editor-ink,#21162d);font:700 18px/1.2 \"Bricolage Grotesque\",ui-sans-serif,system-ui,sans-serif}.ds-tool-panel header p{margin:5px 0 0;color:var(--editor-pencil,#746d78)}.ds-tool-panel header b{color:var(--editor-coral,#ff765b);font-family:\"Bricolage Grotesque\",ui-sans-serif,system-ui,sans-serif}.ds-tool-rule{height:1px;margin:16px 0;background:var(--editor-rule,#c9c1cd)}.ds-tool-panel>p{margin:0}"
        },
        {
            "name": "Mobile Tool Drawer",
            "kind": "custom",
            "refersTo": "tool-panel",
            "description": "Gaveta fixa que preserva todas as ferramentas no celular.",
            "html": "<section class=\"ds-drawer\"><button aria-expanded=\"true\"><span class=\"ds-handle\"></span><span>☷&nbsp; Ferramentas da página</span><span>⌄</span></button><div class=\"ds-drawer-body\"><strong>Oficina da página</strong><small>Capa com foto e fitas</small></div></section>",
            "css": ".ds-drawer{width:320px;overflow:hidden;border-radius:22px 22px 0 0;background:var(--editor-ink,#21162d);color:var(--editor-paper,#fbfaf6);box-shadow:0 -14px 38px rgba(33,22,45,.16)}.ds-drawer button{position:relative;display:grid;width:100%;min-height:58px;grid-template-columns:1fr auto;align-items:center;gap:12px;padding:10px 18px 8px;border:0;background:transparent;color:inherit;font:700 14px/1.2 \"Atkinson Hyperlegible\",ui-sans-serif,system-ui,sans-serif;text-align:left}.ds-drawer button:focus-visible{outline:3px solid var(--editor-coral,#ff765b);outline-offset:-4px}.ds-handle{position:absolute;top:6px;left:50%;width:44px;height:4px;border-radius:999px;background:rgba(251,250,246,.32);transform:translateX(-50%)}.ds-drawer-body{display:grid;gap:4px;padding:18px 18px 24px;border-top:1px solid rgba(251,250,246,.12)}.ds-drawer-body strong{font:700 18px/1.2 \"Bricolage Grotesque\",ui-sans-serif,system-ui,sans-serif}.ds-drawer-body small{color:var(--editor-rule,#c9c1cd);font-size:12px}"
        },
        {
            "name": "Scrapbook Page",
            "kind": "custom",
            "description": "Objeto físico dominante com pilha, fita, lombada e dobra.",
            "html": "<article class=\"ds-scrapbook\"><span class=\"ds-tape ds-tape-left\"></span><span class=\"ds-tape ds-tape-right\"></span><span class=\"ds-spine\"></span><div class=\"ds-paper\"><h3>Nossa história</h3><p>um pedacinho da nossa história</p><span class=\"ds-curl\"></span></div></article>",
            "css": ".ds-scrapbook{position:relative;width:280px;aspect-ratio:3/4;padding:14px;border-radius:24px;background:#b9874d;box-shadow:0 24px 54px rgba(58,36,24,.26);transform:rotate(-.35deg)}.ds-scrapbook:before,.ds-scrapbook:after{position:absolute;inset:8px;content:\"\";border-radius:22px;background:#e7c995;box-shadow:0 10px 18px rgba(58,36,24,.14);transform:rotate(1deg)}.ds-scrapbook:after{inset:11px;transform:rotate(-.7deg)}.ds-paper{position:absolute;inset:18px 16px 16px 30px;z-index:2;overflow:hidden;padding:32px 20px;border:1px solid rgba(58,36,24,.16);border-radius:8px 14px 10px 12px;background:#fbefd1;background-image:radial-gradient(circle at 20% 18%,rgba(255,255,255,.42),transparent 18%),linear-gradient(90deg,rgba(58,36,24,.035) 1px,transparent 1px);background-size:auto,18px 18px;color:#42291d;box-shadow:0 18px 30px rgba(58,36,24,.22);text-align:center}.ds-paper h3{margin:70px 0 8px;font:700 28px/1.05 \"Bricolage Grotesque\",ui-sans-serif,system-ui,sans-serif}.ds-paper p{font:600 20px/1.3 Caveat,cursive}.ds-spine{position:absolute;top:24px;bottom:24px;left:13px;z-index:3;width:18px;border-radius:999px;background:linear-gradient(90deg,#6f3e25,#9f6040 48%,#c98c68);box-shadow:inset -5px 0 8px rgba(58,36,24,.25)}.ds-tape{position:absolute;top:5px;z-index:4;width:72px;height:20px;border-radius:3px;background:rgba(222,176,105,.82);box-shadow:0 7px 14px rgba(58,36,24,.12)}.ds-tape-left{left:42px;transform:rotate(-5deg)}.ds-tape-right{right:24px;transform:rotate(6deg)}.ds-curl{position:absolute;right:0;bottom:0;width:36px;aspect-ratio:1;background:linear-gradient(135deg,#e8e1d7 0 49%,#fffdf8 51% 100%);clip-path:polygon(0 0,100% 0,100% 100%)}"
        }
    ],
    "narrative": {
        "northStar": "Álbum de Coleção Afetiva",
        "overview": "O sistema visual nasce dos álbuns brasileiros de coleção, cadernos de lembranças e estojos de papelaria bem usados. A interface é a bancada organizada ao redor do presente: precisa, legível e discreta. O scrapbook é a peça expressiva — com folhas empilhadas, fibra, recortes, fita, lombada, volume e marcas de manuseio — enquanto o chrome evita competir com ele.\n\nA personalidade é gráfica, tátil e adulta. Numeração editorial, abas recortadas, marcas de registro e pequenas etiquetas dão ritmo sem transformar o produto em jogo. O movimento vem do mundo físico: páginas viram, folhas assentam e painéis deslizam como divisórias de um fichário.\n\nO caminho principal atende iniciantes: layouts prontos carregam a composição e cada área de edição explica o próximo gesto. Liberdade existe como ajuste progressivo; nunca como uma tela vazia que exige repertório visual.",
        "keyCharacteristics": [
            "O presente permanece o maior e mais rico objeto da interface.",
            "A criação é guiada por layouts prontos e espaços reconhecíveis para preencher.",
            "Matéria aparece onde existe matéria: papel, fotografia, tecido, fita e encadernação.",
            "A interface usa contraste e tipografia de ferramenta; ornamento pertence ao conteúdo.",
            "Desktop e celular oferecem as mesmas capacidades com composições diferentes."
        ],
        "rules": [
            {
                "name": "The Artifact Owns Color Rule",
                "body": "Temas podem ser exuberantes dentro do presente; o chrome mantém Tinta de Berinjela, Bancada Lavanda e um único Carimbo Coral.",
                "section": "colors"
            },
            {
                "name": "The Paper Is Precious Rule",
                "body": "Folha de Álbum representa papel real ou escrita. Não cubra a aplicação inteira com bege, creme ou textura.",
                "section": "colors"
            },
            {
                "name": "The Handwriting Is a Memory Rule",
                "body": "Caveat só aparece como voz da pessoa dentro da folha; nunca em botões, menus, status ou instruções.",
                "section": "typography"
            },
            {
                "name": "The Honest Material Rule",
                "body": "Só objetos que poderiam levantar da bancada recebem sombra física. Painéis de interface usam contraste, linha e posição.",
                "section": "elevation"
            }
        ],
        "dos": [
            "Do manter o scrapbook maior, mais iluminado e mais detalhado que qualquer painel.",
            "Do usar layouts prontos como caminho principal e edição livre como ajuste progressivo.",
            "Do diferenciar interface, fotografia, papel, fita e tecido por material e comportamento.",
            "Do preservar affordances familiares e alvos de toque generosos em qualquer composição.",
            "Do reduzir movimento quando solicitado sem esconder conteúdo ou estado."
        ],
        "donts": [
            "Don't recriar o antigo mundo creme, serifado e vermelho em uma versão apenas mais polida.",
            "Don't transformar cada container em cartão arredondado flutuante.",
            "Don't usar pontos, medalhas, mascotes ou recompensas para simular progresso.",
            "Don't aplicar textura sobre texto pequeno, controles ou áreas que precisam de precisão.",
            "Don't esconder funções no celular; reorganize-as em ambientes próprios."
        ]
    }
}
